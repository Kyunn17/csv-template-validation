{
  "name": "csv-template-validation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:dry": "tsx scripts/deploy.ts --dry-run",
    "deploy:gen": "tsx scripts/deploy.ts --generate-only",
    "deploy:gen:aws": "tsx scripts/deploy.ts --target aws-lambda --generate-only",
    "deploy:secrets": "tsx scripts/deploy.ts --secrets-only",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "csv-parse": "^7.0.3",
    "hyparquet": "^1.31.5",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
